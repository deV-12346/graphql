generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model users {
  user_id      Int       @id @default(autoincrement())
  username     String    @db.VarChar(255)
  email        String    @unique @db.VarChar(255)
  phone_number String    @db.VarChar(255)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  address      address[]
  orders       orders[]
  todos        todos[]
}

model products {
  product_id     Int       @id @default(autoincrement())
  product_name   String    @db.VarChar(255)
  category       String    @db.VarChar(255)
  original_price Float
  offer_price    Float
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  stock          Int       @default(2)
}

model address {
  id      Int     @id @default(autoincrement())
  street  String? @db.VarChar(255)
  city    String? @db.VarChar(100)
  state   String? @db.VarChar(100)
  country String? @db.VarChar(100)
  pincode String? @db.VarChar(10)
  user_id Int
  users   users   @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model orders {
  order_id     Int       @id @default(autoincrement())
  order_status String?   @db.VarChar(50)
  total_amount Decimal?  @db.Decimal(10, 2)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  user_id      Int
  product_id   Int?
  address_id   Int?
  users        users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  payment      payment?

  @@index([product_id], map: "product_id_idx")
  @@index([user_id], map: "user_id_idx")
}

model payment {
  payment_id     Int       @id @default(autoincrement())
  payment_method String?   @db.VarChar(50)
  payment_status String?   @db.VarChar(50)
  transaction_id String?   @db.VarChar(100)
  amount         Decimal?  @db.Decimal(10, 2)
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  order_id       Int       @unique
  orders         orders    @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction)
}

model sessions {
  session_id    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  refresh_token String?
  device        String?  @db.VarChar(255)
  token_version Int?
  revoked       Boolean? @default(false)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  last_used_at  DateTime @default(now()) @db.Timestamp(6)
  expires_at    DateTime @db.Timestamp(6)
  userss        userss   @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model userss {
  user_id       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username      String     @db.VarChar(255)
  email         String     @unique @db.VarChar(255)
  phone         String?    @db.VarChar(255)
  token_version Int?       @default(1)
  created_by    DateTime?  @default(now()) @db.Timestamp(6)
  password      String     @db.VarChar(255)
  sessions      sessions[]
}

model todos {
  id         Int       @id @default(autoincrement())
  title      String    @db.VarChar(255)
  completed  Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  user_id    Int
  users      users     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_todos_user")
}
